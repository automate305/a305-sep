# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Settings → API → service_role

# ── Webhook Auth ──────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
WEBHOOK_SECRET=your-random-secret-here

# Bearer token Vercel Cron sends to /api/cron/daily-send and
# /api/cron/daily-warmup. Generate the same way: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here

# Master switch for the daily campaign-send cron. Off ('false'/unset) is the
# safe default; the cron reports "disabled" and sends nothing either way.
CAMPAIGN_AUTOMATION_ENABLED=false

# Master switch for the daily warmup cron. Off ('false'/unset) is the safe
# default — nothing is sent automatically until this is explicitly 'true'.
WARMUP_AUTOMATION_ENABLED=false

# Separate human-facing key for the private operational dashboard.
DASHBOARD_ACCESS_KEY=your-dashboard-access-key-here

# Dashboard budget threshold. Actual spend comes from the server-only ai_usage ledger.
AI_MONTHLY_BUDGET_USD=50

# ── Vercel Deployment URL ─────────────────────────────────────
WEBHOOK_URL=https://a305-sep.vercel.app       # your Vercel project URL

# ── ElevenLabs (voice/TTS) ────────────────────────────────────
# Get the key at elevenlabs.io → profile → API Keys.
# Reserved for a future voice feature — no code reads this yet.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── Warmup seed inboxes ───────────────────────────────────────
# At least 4 real inboxes Matt and Tamiko's warmup mail round-robins
# between. Comma-separated. Never real prospects.
WARMUP_SEED_RECIPIENTS=seed-one@example.com,seed-two@example.com,seed-three@example.com,seed-four@example.com

# ── Aesthetic · Hostinger SMTP Passwords ─────────────────────
# matt@ and tamiko@ are the two real mailboxes. Keep aliases inactive unless
# they are converted to real mailboxes and verified independently.

SMTP_PASS_MATT=your-matt-hostinger-password
SMTP_PASS_DON=your-matt-hostinger-password      # same as MATT (alias)
SMTP_PASS_ED=your-matt-hostinger-password
SMTP_PASS_EDDIE=your-matt-hostinger-password
SMTP_PASS_MATTHEW=your-matt-hostinger-password
SMTP_PASS_ROB=your-matt-hostinger-password

SMTP_PASS_TAMIKO=your-tamiko-hostinger-password
SMTP_PASS_JEN=your-tamiko-hostinger-password    # same as TAMIKO (alias)
SMTP_PASS_JENNY=your-tamiko-hostinger-password
SMTP_PASS_JESS=your-tamiko-hostinger-password
SMTP_PASS_JESSICA=your-tamiko-hostinger-password
SMTP_PASS_TAMI=your-tamiko-hostinger-password

# ── HVAC · Google Workspace SMTP App Passwords ────────────────
# cam@ is the confirmed warmed HVAC sender. Use a Google App Password, not the
# account's normal password. The remaining addresses stay inactive unless they
# become real, independently warmed Google Workspace mailboxes.
SMTP_PASS_CAM=your-cam-google-app-password
SMTP_PASS_CAMILO=your-camilo-google-app-password
SMTP_PASS_HELLO=your-hello-google-app-password
SMTP_PASS_SALES=your-sales-google-app-password
