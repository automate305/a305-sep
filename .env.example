# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Settings → API → service_role

# ── Webhook Auth ──────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
WEBHOOK_SECRET=your-random-secret-here

# ── Vercel Deployment URL ─────────────────────────────────────
WEBHOOK_URL=https://a305-sep.vercel.app       # your Vercel project URL

# ── Dashboard key (optional) ──────────────────────────────────
# Key for the /dashboard.html operator view. If unset, the dashboard falls
# back to WEBHOOK_SECRET — but set a separate value so the sending secret
# never has to be typed into a browser. openssl rand -hex 24
DASHBOARD_PASSWORD=your-dashboard-key

# ── ElevenLabs (voice/TTS) ────────────────────────────────────
# Get the key at elevenlabs.io → profile → API Keys.
# Reserved for a future voice feature — no code reads this yet.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── Hostinger SMTP Passwords ──────────────────────────────────
# One env var per mailbox. Aliases share the main mailbox password.
# matt@ and its aliases (don, ed, eddie, matthew, rob) → same password
# tamiko@ and its aliases (jen, jenny, jess, jessica, tami) → same password

SMTP_PASS_MATT=your-matt-hostinger-password
SMTP_PASS_DON=your-matt-hostinger-password      # same as MATT (alias)
SMTP_PASS_ED=your-matt-hostinger-password
SMTP_PASS_EDDIE=your-matt-hostinger-password
SMTP_PASS_MATTHEW=your-matt-hostinger-password
SMTP_PASS_ROB=your-matt-hostinger-password

SMTP_PASS_TAMIKO=your-tamiko-hostinger-password
SMTP_PASS_JEN=your-tamiko-hostinger-password    # same as TAMIKO (alias)
SMTP_PASS_JENNY=your-tamiko-hostinger-password
SMTP_PASS_JESS=your-tamiko-hostinger-password
SMTP_PASS_JESSICA=your-tamiko-hostinger-password
SMTP_PASS_TAMI=your-tamiko-hostinger-password

# ── HVAC senders (automate305.com) ────────────────────────────
# cam@ is the live HVAC sender. camilo@ / hello@ / sales@ are warmup slots —
# create the real Hostinger mailbox, then set its password here and flip the
# sender active in Supabase.
SMTP_PASS_CAM=your-cam-hostinger-password
SMTP_PASS_CAMILO=your-cam-hostinger-password
SMTP_PASS_HELLO=your-cam-hostinger-password
SMTP_PASS_SALES=your-cam-hostinger-password
