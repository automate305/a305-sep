# ── Claude ─────────────────────────────────────────────────────
# Required for live analysis; the sample deal works without it.
ANTHROPIC_API_KEY=sk-ant-...
# MINTIQ_MODEL=claude-opus-5
# MINTIQ_SEARCHES_PER_AGENT=6

# ── Memo archive (optional; same names as the rest of a305-sep) ─
# Without these, memos live in process memory only (fine locally, not on Vercel).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Intake webhook (Mint's pre-qual form → MintIQ) ──────────────
# openssl rand -hex 32. Send as header `x-mintiq-secret` or `?secret=`.
MINTIQ_WEBHOOK_SECRET=
# Public base URL used in memo links and emails (defaults to the request host).
# MINTIQ_PUBLIC_URL=https://mintiq-eight.vercel.app

# ── Memo email delivery (Hostinger SMTP by default) ─────────────
MINTIQ_SMTP_USER=mintiq@automate305.com
MINTIQ_SMTP_PASS=
# MINTIQ_SMTP_HOST=smtp.hostinger.com
# MINTIQ_SMTP_PORT=465
# MINTIQ_FROM="MintIQ <mintiq@automate305.com>"
# Default recipient(s) for webhook-generated memos, comma-separated.
MINTIQ_NOTIFY_TO=felipe@mintfinancialgroup.com

# ── Server ─────────────────────────────────────────────────────
# PORT=3000
# MINTIQ_MAX_BODY=4mb
